## Importando as bibliotecas
import numpy as np

## Inputs
Q = 0.05 # vazão volumétrica em [m^3/s]
L1 = 30 # comprimento 1 em [m]
D1 = 0.1 # diametro 1 em [m]
f1 = 0.02 # fator de atrito de Darcy 1
K1 = 1.5 # coeficiente de perda localizada 1
L2 = 20 # comprimento 2 em [m]
D2 = 0.08 # diametro 2 em [m]
f2 = 0.022 # fator de atrito de Darcy 2
K2 = 1 # coeficiente de perda localizada 2
Kv = 8 # perda localizada da válvula
g = 9.81 # aceleração da gravidade em [m/s^2]
tol = 10e-8  # tolerância
k_max = 10e5 # limite de iterações
Q1_0 = 0.03 # estimativa inicial 1 em [m^3/s]
Q2_0 = 0.02 # estimativa inicial 2 em [m^3/s]

## Calculando R1 e R2
R1 = ((f1*(L1/D1))+K1)*(16/(2*g*(np.pi**2)*(D1**4)))
R2 = ((f2*(L2/D2))+K2+Kv)*(16/(2*g*(np.pi**2)*(D2**4)))

## Definindo as funções 1 e 2
def f1(Q1,Q2):
    resultado = Q1 + Q2 - Q
    return resultado
def f2(Q1,Q2):
    resultado = R1*(Q1**2) - R2*(Q2**2)
    return resultado

## Loop de cálculo

Q1 = Q1_0  # vazão 1 atual
Q2 = Q2_0  # vazão 2 atual
erro = 1  # erro inicial para o critério de convergência
k = 0  # contador de iterações
F1 = f1(Q1,Q2) # F1(Q1,Q2) inicial
F2 = f2(Q1,Q2) # F1(Q1,Q2) inicial

while abs(erro) >= tol:

    # calculo dos elementos da matriz jacobiana
    a = 1
    b = 1
    c = 2*R1*Q1
    d = -2*R2*Q2

    # parâmetros do sistema linear
    r1 = -F1
    r2 = -F2
    D = (a*d)-(b*c) # determinante principal
    
    # solução do sistema pela regra de Cramer
    dQ1 = ((r1*d)-(b*r2))/D
    dQ2 = ((a*r2)-(r1*c))/D

    # atualização de valores
    Q1 = Q1 + dQ1
    Q2 = Q2 + dQ2
    F1 = f1(Q1,Q2)
    F2 = f2(Q1,Q2)
    k = k+1
    
    # Cálculo do erro
    erro = np.maximum(abs(dQ1),abs(dQ2))

    # Resultados
    print(f'{k}° iteração\nQ1 = {Q1:.5f} m^3/s e Q2 = {Q2:.5f} m^3/s\nF1 = {F1:.5f} e F2 = {F2:.5f}'
          f'\ndQ1 = {dQ1:.5f} e dQ2 = {dQ2:.5f}\n')
    
    # Limite de iterações
    if k >= k_max:
        print('Não houve convergência')
        break

## Cálculo da velocidade média
U1 = (4*Q1)/(np.pi*(D1**2))
U2 = (4*Q2)/(np.pi*(D2**2))

## Cálculo da vazão total
Q = Q1+Q2

## Cálculo das perdas de carga
h1 = R1*(Q1**2)
h2 = R2*(Q2**2)

## Outputs
print(f'Resultado Final\nVazões convergidas encontradas:\nQ1 = {Q1:.5f} m^3/s e Q2 = {Q2:.5f} m^3/s'
      f'\nNúmero de iterações necessárias: {k}\n')
print(f'\n--- Velocidade Média Calculada ---\n')
print(f'U1 = {U1} m/s\nU2 = {U2} m/s\n')
print(f'\n--- Vazão Total Calculada ---\n')
print(f'Q = {Q} m^3/s\n')
print(f'\n--- Perda de Carga Calculada ---\n')
print(f'h1 = {h1}\nh2 = {h2}')
