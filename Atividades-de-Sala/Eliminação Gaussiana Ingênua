## Importando as bibliotecas
import numpy as np

## Inputs

# vazões voluméricas em m^3/min
Q01 = 5
Q03 = 8
Q12 = 3
Q15 = 3
Q23 = 1
Q24 = 1
Q25 = 1
Q31 = 1
Q34 = 8
Q44 = 11
Q54 = 2
Q55 = 2

# concentrações em mg/m^3
c1 = 10
c3 = 20

# equações do sistema:
# (Q12+Q15)*c1 - Q31*c3 = Q01*c1
# -Q12*c1 + (Q23+Q24+Q25)*c2 = 0
# etc (completar)
# forma matricial: A*c = b

## definindo as matrizes A e b:
A = np.array([
    [Q12+Q15, 0, -Q31, 0, 0],
    [-Q12, Q23+Q24+Q25, 0, 0, 0],
    [0, -Q23, Q31+Q34, 0, 0],
    [0, -Q24, -Q34, Q44, -Q54],
    [-Q15, -Q25, 0, 0, Q54+Q55]
])

b = np.array([
    [Q01*c1],
    [0],
    [Q03*c3],
    [0],
    [0]
])

c = np.zeros((5,1))

print(f'Matrizes iniciais:\n\nA =\n{A}\n\nb =\n{b}\n\n')

# definindo o tamanho:
n = A.shape[0] # tamanho da matriz é 5x5

md = 0 # contador de multiplicação e divisão
ss = 0 # contador de soma e subtração

## Loops da eliminação
for k in range(n-1):  # linha e coluna do pivô
    for i in range(k+1,n):  # linha onde haverá eliminação
        m = A[i,k]/A[k,k]  # multiplicador
        for j in range(k+1,n):  # colunas da linha i
            A[i,j] = A[i,j] - (m*A[k,j])
            md = md+1
            ss = ss+1
        b[i] = b[i] - (m*b[k])
        A[i,k] = 0
        md = md+2
        ss = ss+1
    print(f'(para k={k})\n\nA =\n{A}\n\nb =\n{b}\n')

print(f'\nMatriz triangular superior resultante:\n\nA =\n{A}\n\n')

## Loop da substituição retroativa
c[n-1] = b[n-1]/A[n-1,n-1]
for i in range (n-2,-1,-1):
    soma = b[i]
    for j in range(i,n):
        soma = soma - (A[i,j]*c[j])
        md = md+1
        ss = ss+1
    c[i] = soma/A[i,i]
    md = md+1
    print(f'(para i={i})\n\nc =\n{c}\n')

print(f'operações de multiplicação/divisão: {md}\noperações de soma/subtração: {ss}\ntotal de FLOPS: {md+ss}')
