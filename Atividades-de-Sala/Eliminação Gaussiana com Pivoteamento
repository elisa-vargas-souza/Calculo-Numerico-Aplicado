from math import sin, cos, radians
 
import numpy as np                 # so para o numero de condicao (verificacao)
 
eps = 2.22e-16
phi = 45.0
Fref = [100.0, -80.0, 20.0, 35.0, 15.0]
pert = 0.01
configs = {"A": (15.0, 65.0), "B": (10.0, 10.1), "C": (0.01, 0.02)}
 
 
def arr(x, dig):                   # arredonda para 'dig' algarismos significativos
    return x if dig is None else float(f"{x:.{dig - 1}e}")
 
 
# ================= Parte 1: sistema 2x2 =================
print("PARTE 1 - duas barras")
print(f"{'cfg':<4}{'det':>13}{'cond_inf':>12}{'dF (perturb. py)':>20}{'dF (perturb. px)':>20}")
for nome, (th1, th2) in configs.items():
    s1, s2, c1, c2 = sin(radians(th1)), sin(radians(th2)), cos(radians(th1)), cos(radians(th2))
    det = s1 * c2 - s2 * c1
    cond = np.linalg.cond(np.array([[s1, s2], [c1, c2]]), np.inf)
    dFs = []
    for i in (1, 0):                                             # perturba py, depois px
        r = [s1 * 100 - s2 * 80, c1 * 100 - c2 * 80]             # -p = A2 Fref
        r[i] -= pert                                             # rhs = -(p + dp)
        F1 = (r[0] * c2 - s2 * r[1]) / det                       # Cramer (2x2)
        F2 = (s1 * r[1] - c1 * r[0]) / det
        dFs.append(max(abs(F1 - 100), abs(F2 + 80)))             # Fref = (100, -80)
    print(f"{nome:<4}{det:>13.4e}{cond:>12.3e}{dFs[0]:>20.4e}{dFs[1]:>20.4e}")
 
# ================= Partes 2-4: sistema 5x5 =================
# casos: (cenario, pivotear, digitos, perturbacao em b: None | indice, rotulo)
casos = []
for cen in ("A", "C"):
    for piv in (False, True):
        casos.append((cen, piv, None, None, "duplo"))
for cen in ("A", "C"):
    for piv in (False, True):
        casos.append((cen, piv, 4, None, "4 digitos"))
for cen in ("A", "C"):
    for idx in (1, 0):                          # b2 (pedido) e b1 (extra)
        casos.append((cen, True, None, idx, f"perturb. b{idx + 1}"))
 
Fcalc = {}                                      # F do caso duplo com pivoteamento
print("\nPARTES 2-4 - sistema 5x5")
print(f"{'cen':<4}{'versao':<9}{'precisao':<14}{'erro_inf':>11}{'||r||_inf':>11}  trocas / observacao")
 
for cen, piv, dig, idx, rot in casos:
    th1, th2 = configs[cen]
    t1, t2, f = radians(th1), radians(th2), radians(phi)
    A0 = [[sin(t1), sin(t2), 1, 0, 0],
          [cos(t1), cos(t2), 0, 0, 0],
          [0, 0, -1, cos(f), 0],
          [0, 0, 0, -sin(f), -1],
          [0, 0, 0, 0, 1]]
    n = 5
    b0 = [sum(A0[i][j] * Fref[j] for j in range(n)) for i in range(n)]   # b = A Fref
    if idx is not None:
        b0[idx] += pert
 
    A = [linha[:] for linha in A0]
    b = b0[:]
    limite = n * eps * max(abs(v) for linha in A0 for v in linha)
    md = sa = 0
    trocas = []
    verbose = (rot == "duplo")
    falhou = False
    if verbose:
        print(f"\n--- cenario {cen}, {'pivoteamento parcial' if piv else 'ingenua'} "
              f"(limite_pivo = {limite:.2e}) ---")
 
    # ---- eliminacao progressiva ----
    for k in range(n - 1):
        p = k
        if piv:
            for i in range(k + 1, n):
                if abs(A[i][k]) > abs(A[p][k]):
                    p = i
        if abs(A[p][k]) <= limite:
            falhou = True
            break
        if p != k:
            A[k], A[p] = A[p], A[k]                 # troca de linhas inteiras
            b[k], b[p] = b[p], b[k]
            trocas.append((k + 1, p + 1))
        for i in range(k + 1, n):
            fator = arr(A[i][k] / A[k][k], dig);          md += 1
            for j in range(k + 1, n):
                A[i][j] = arr(A[i][j] - arr(fator * A[k][j], dig), dig);   md += 1; sa += 1
            b[i] = arr(b[i] - arr(fator * b[k], dig), dig);                md += 1; sa += 1
            A[i][k] = 0.0
        if verbose:
            print(f"etapa k={k + 1}: p={p + 1}, pivo apos a troca = {A[k][k]:.6e}")
            for i in range(n):
                print("   " + " ".join(f"{v:11.4e}" for v in A[i]) + f" | {b[i]:11.4e}")
    if abs(A[n - 1][n - 1]) <= limite:
        falhou = True
    if falhou:
        print(f"{cen:<4}{'parcial' if piv else 'ingenua':<9}{rot:<14}  pivo ~ 0: sistema nao resolvido")
        continue
 
    # ---- substituicao regressiva ----
    x = [0.0] * n
    x[n - 1] = arr(b[n - 1] / A[n - 1][n - 1], dig);       md += 1
    for i in range(n - 2, -1, -1):
        soma = b[i]
        for j in range(i + 1, n):
            soma = arr(soma - arr(A[i][j] * x[j], dig), dig);   md += 1; sa += 1
        x[i] = arr(soma / A[i][i], dig);                   md += 1
 
    # ---- erro e residuo (contra A e b originais) ----
    erro = max(abs(x[i] - Fref[i]) for i in range(n))
    resid = max(abs(sum(A0[i][j] * x[j] for j in range(n)) - b0[i]) for i in range(n))
    obs = f"trocas {trocas or 'nenhuma'}"
    if rot == "duplo":
        obs += f" | FLOPs: {md} mult/div, {sa} soma/sub"
        if piv:
            Fcalc[cen] = x
        print(f"F = {[round(v, 8) for v in x]}")
    if idx is not None:                          # item 8: compara com o caso sem perturbacao
        dF = max(abs(x[i] - Fcalc[cen][i]) for i in range(n))
        obs = f"||db|| = {pert:g}, ||dF|| = {dF:.4e}, razao = {dF / pert:.4e}, cond_inf(A) = " \
              f"{np.linalg.cond(np.array(A0), np.inf):.3e}"
    print(f"{cen:<4}{'parcial' if piv else 'ingenua':<9}{rot:<14}{erro:>11.3e}{resid:>11.3e}  {obs}")
