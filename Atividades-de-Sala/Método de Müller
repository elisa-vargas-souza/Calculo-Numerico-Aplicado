# Definindo a função polinomial
def f(x):
    a_0 = -b*Q**2
    a_1 = -2*z*Q**2
    a_3 = g*b**3
    a_4 = 3*g*z*b**2
    a_5 = 3*g*b*z**2
    a_6 = g*z**3
    resultado = a_6*x**6 + a_5*x**5 + a_4*x**4 + a_3*x**3 + a_1*x + a_0
    return resultado

