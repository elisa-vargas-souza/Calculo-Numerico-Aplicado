from math import sqrt
 
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
 
b, z, g = 4.0, 1.5, 9.81
tol, nmax = 1e-8, 100
 
 
def f(H, Q):
    return (g * z**3 * H**6 + 3 * g * b * z**2 * H**5 + 3 * g * b**2 * z * H**4
            + g * b**3 * H**3 - 2 * Q**2 * z * H - Q**2 * b)
 
 
# ---- Item 3: coeficientes para Q = 20 ----
Q = 20.0
coef = [g * z**3, 3 * g * b * z**2, 3 * g * b**2 * z, g * b**3, 0.0, -2 * Q**2 * z, -Q**2 * b]
print("Coeficientes a6..a0 (Q = 20):", [round(a, 5) for a in coef])
 
# ---- Casos: (Q, H0, H1, H2, tipo) ----
casos = [(20.0, 0.5, 1.0, 1.5, "principal")]
for Q in [5, 10, 15, 20, 25, 30, 35, 40]:                  # varredura de vazoes
    Hr = (Q**2 / (g * b**2)) ** (1 / 3)                    # chute proporcional a Hr (canal retangular)
    casos.append((float(Q), 0.8 * Hr, 1.0 * Hr, 1.2 * Hr, "varredura"))
for tripla in [(0.1, 0.5, 1.0), (1.0, 2.0, 3.0), (-1.0, 0.0, 1.0)]:   # item 15(f)
    casos.append((20.0, *tripla, "item f"))
 
vazoes, profs = [], []
for Q, H0, H1, H2, tipo in casos:
    if tipo == "principal":
        print(f"\nMuller, Q = 20, chutes {H0}, {H1}, {H2}")
        print(f"{'k':>2}{'H0':>12}{'H1':>12}{'H2':>12}{'H3':>14}{'f(H3)':>13}{'|H3-H2|':>11}")
 
    ini = (H0, H1, H2)                                     # chutes iniciais (para impressao)
    convergiu = False
    for k in range(1, nmax + 1):
        f0, f1, f2 = f(H0, Q), f(H1, Q), f(H2, Q)
        h0, h1 = H1 - H0, H2 - H1
        d0, d1 = (f1 - f0) / h0, (f2 - f1) / h1
        a = (d1 - d0) / (h1 + h0)
        bM = a * h1 + d1
        c = f2
 
        disc = bM**2 - 4 * a * c
        if disc < 0:                                       # raiz complexa: metodo real para
            break
        D = sqrt(disc)
        E = bM + D if abs(bM + D) > abs(bM - D) else bM - D
        H3 = H2 - 2 * c / E
        erro = abs(H3 - H2)
 
        if tipo == "principal":
            print(f"{k:>2}{H0:>12.6f}{H1:>12.6f}{H2:>12.6f}{H3:>14.10f}{f(H3, Q):>13.3e}{erro:>11.2e}")
 
        if erro < tol:
            convergiu = True
            break
        H0, H1, H2 = H1, H2, H3
 
    # ---- resultados de cada caso ----
    if tipo == "principal":
        Hc = H3
        A = b * Hc + z * Hc**2
        T = b + 2 * z * Hc
        Fr2 = Q**2 * T / (g * A**3)
        print(f"\nHc = {Hc:.10f} m em {k} iteracoes")
        print(f"Ac = {A:.6f} m2, Tc = {T:.6f} m, Fr^2 = {Fr2:.12f}, Fr = {sqrt(Fr2):.12f}")
        print("Raiz real e positiva:", Hc > 0)
        print("Todas as raizes (numpy, so conferencia):", np.round(np.roots(coef), 4))
        print("\nVarredura de vazoes:")
        print(f"{'Q':>5}{'Hc [m]':>14}{'iter':>6}")
    elif tipo == "varredura":
        print(f"{Q:>5.0f}{H3:>14.8f}{k:>6}")
        vazoes.append(Q)
        profs.append(H3)
    else:
        if convergiu:
            print(f"item f: chutes {ini} -> H = {H3:.10f} m ({k} iteracoes)")
        else:
            print(f"item f: chutes {ini} -> nao convergiu (discriminante negativo na iteracao {k})")
 
# ---- Arquivo Q x Hc e grafico ----
with open("resultados_Q_Hc.txt", "w") as arq:
    arq.write("# Q [m3/s]    Hc [m]\n")
    for Q, Hc in zip(vazoes, profs):
        arq.write(f"{Q:8.1f} {Hc:14.8f}\n")
 
plt.figure(figsize=(6.5, 4))
plt.plot(vazoes, profs, "o-", lw=2)
plt.xlabel("Vazão Q (m³/s)")
plt.ylabel("Profundidade crítica Hc (m)")
plt.grid(alpha=0.3)
plt.tight_layout()
plt.savefig("grafico_Hc_Q.png", dpi=150)
